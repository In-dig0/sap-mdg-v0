# =============================================================================
# MDG - Migration Data Governance | .env.example
# Versione: v1
#
# Copia in .env e compila i valori reali. NON committare .env su Git.
#   cp .env.example .env
#
# Per generare JWT_SECRET:
#   openssl rand -hex 32
# =============================================================================

# --- PostgreSQL ---
POSTGRES_IMAGE=postgres:18.3-alpine3.23
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mdg
POSTGRES_USER=mdg_user
POSTGRES_PASSWORD=CAMBIA_QUESTA_PASSWORD

# --- PgAdmin ---
PGADMIN_PORT=8080
PGADMIN_DEFAULT_EMAIL=tua@email.com
PGADMIN_DEFAULT_PASSWORD=CAMBIA_QUESTA_PASSWORD

# --- SFTP (SFTPGo) ---
# NOTA PRODUZIONE: usa una porta non standard per SFTP (es. 2222)
# La porta 22 su OCI è riservata a SSH del server host.
SFTP_PORT=2222
SFTP_KEY_PATH=./sftpgo/keys
SFTPGO_ADMIN_PORT=8082
SFTPGO_ADMIN_USER=admin
SFTPGO_ADMIN_PASSWORD=CAMBIA_QUESTA_PASSWORD
SFTPGO_MDG_USER=mdg_sftp
SFTPGO_MDG_PASSWORD=CAMBIA_QUESTA_PASSWORD
# Chiave pubblica SSH utente mdg_sftp (lasciare vuoto per auth solo password)
SFTPGO_MDG_PUBKEY=

# --- Streamlit ---
STREAMLIT_PORT=8501

# --- Auth API ---
AUTH_API_URL=http://mdg_auth:8001
# Genera con: openssl rand -hex 32
JWT_SECRET=GENERA_CON_openssl_rand_-hex_32
ADMIN_EMAIL=admin@tuodominio.com
ADMIN_PASSWORD=CAMBIA_QUESTA_PASSWORD_MIN_16_CHARS
ADMIN_NAME=Amministratore MDG

# --- Bruin ---
BRUIN_IMAGE=ghcr.io/bruin-data/bruin:latest

# --- FastAPI ---
FASTAPI_PORT=8000

# --- Rete interna ---
MDG_NETWORK=mdg_network

# --- Timezone ---
TZ=Europe/Rome

# --- HMRC API v2 (opzionale, solo per VAT GB) ---
# Registrazione: https://developer.service.hmrc.gov.uk
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
